# VUGA backend proxy configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is git-ignored on purpose.

# Port the proxy listens on (default 8787)
PORT=8787

# Comma-separated list of allowed browser/app origins ("*" allows all — dev only)
CORS_ORIGIN=*

# --- Provider selection -----------------------------------------------------
# mock  : deterministic fake responses, no network calls, no keys needed
# google: Google Cloud Speech-to-Text V2 + Translation NMT + Text-to-Speech
VUGA_PROVIDER=mock

# --- Google Cloud (required when VUGA_PROVIDER=google) ----------------------
# Paste the FULL JSON key of a Google Cloud service account (single line).
# Enable these APIs on the project: Speech-to-Text, Cloud Translation, Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Overrides GOOGLE_APPLICATION_CREDENTIALS_JSON when set (recommended on Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS_JSON_FILE=/secrets/gcp-sa.json
# Google Cloud project id used for Speech-to-Text V2 project/location paths
GOOGLE_CLOUD_PROJECT=
# Cloud region for STT V2 (default: global)
GOOGLE_CLOUD_LOCATION=global

# What mock mode does with transcribe/translate calls (informational only)
MOCK_LATENCY_MS=150
