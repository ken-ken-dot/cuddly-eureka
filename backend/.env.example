# VUGA backend proxy configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is git-ignored on purpose.

# Port the proxy listens on (default 8787)
PORT=8787

# Comma-separated list of allowed browser/app origins ("*" allows all — dev only)
CORS_ORIGIN=*

# --- Provider selection -----------------------------------------------------
# mock  : deterministic fake responses, no network calls, no keys needed
# google: Google Cloud Speech-to-Text V2 + Translation NMT + Text-to-Speech
VUGA_PROVIDER=mock

# --- Google Cloud (required when VUGA_PROVIDER=google) ----------------------
# ONE service account with TWO roles: Cloud Speech Client + Cloud Translation
# API User (multilingual brief Section 2). Enable these APIs on the project:
# Speech-to-Text, Cloud Translation, Cloud TTS. Any ONE of the three key forms
# below is enough — inline JSON wins when several are set.
#
# Option A — the multilingual brief's exact two-variable setup:
#   GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
#   GCP_PROJECT_ID=your-project-id
# Option B — inline JSON (single line), V1's original form:
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Option C — file path via mounted secret (recommended on Cloud Run):
# GOOGLE_APPLICATION_CREDENTIALS_JSON_FILE=/secrets/gcp-sa.json
# Google Cloud project id (GOOGLE_CLOUD_PROJECT and GCP_PROJECT_ID are aliases)
GOOGLE_CLOUD_PROJECT=
# Cloud region default for STT V2 — per-language routing (rw -> eu) is handled
# by the STT_LANGUAGE_ROUTING table in src/languages.ts, which takes precedence.
GOOGLE_CLOUD_LOCATION=global

# --- Auth + sync (Postgres, hand-rolled — brief Sections 2-5) ---------------
# Managed Postgres connection string (Neon recommended: https://neon.tech).
# Copy the pooled connection string from the Neon console.
DATABASE_URL=
# Secret for signing short-lived access-token JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=
# Second, DIFFERENT secret for signing refresh-token JWTs (typ "refresh").
# Generate separately; if it ever equals JWT_SECRET the server refuses to start.
JWT_REFRESH_SECRET=

# What mock mode does with transcribe/translate calls (informational only)
MOCK_LATENCY_MS=150
