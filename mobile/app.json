{
  "expo": {
    "name": "VUGA",
    "slug": "vuga",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vuga",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1C1815",
    "splash": {
      "backgroundColor": "#1C1815",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VUGA listens only while you press the mic button, to transcribe and translate your speech."
      },
      "bundleIdentifier": "app.vuga.mobile"
    },
    "android": {
      "package": "app.vuga.mobile",
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#1C1815"
      }
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
